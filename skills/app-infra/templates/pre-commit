#!/usr/bin/env bash
# Git-Hook gegen Schlüssel und .env-Dateien, plus Format-Prüfung, wenn SwiftFormat installiert ist.
# Installieren:  cp pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Im Notfall überspringen: git commit --no-verify (dann bewusst prüfen!)
set -uo pipefail

fail=0
staged="$(git diff --cached --name-only --diff-filter=ACM)"

# 1. Keine .env-Dateien (außer .env.example)
if printf '%s\n' "$staged" | grep -E '(^|/)\.env(\..+)?$' | grep -vE '\.env\.example$' >/dev/null; then
  echo "❌ .env-Datei im Commit. Werte gehören in Secrets, ins Repo nur .env.example."
  fail=1
fi

# 2. Typische Schlüssel im hinzugefügten Code
patterns='xkeysib-[A-Za-z0-9-]{20,}|AIza[0-9A-Za-z_-]{35}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{40,}|sk_live_[0-9A-Za-z]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|sb_secret_[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
hits="$(git diff --cached -U0 | grep -E '^\+' | grep -Eo "$patterns" || true)"
if [ -n "$hits" ]; then
  echo "❌ Möglicher Schlüssel im Commit (gekürzt):"
  printf '%s\n' "$hits" | sed -E 's/^(.{8}).*/  \1…/'
  echo "   Schlüssel aus der Datei entfernen, als Secret setzen und rotieren, falls er schon geteilt wurde."
  fail=1
fi

# 3. gitleaks, falls installiert (neue und alte Befehlsform)
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --redact --no-banner >/dev/null 2>&1; then
    gitleaks protect --staged --redact --no-banner || fail=1
  fi
fi

# 4. SwiftFormat, falls installiert und konfiguriert
swift_files="$(printf '%s\n' "$staged" | grep -E '\.swift$' || true)"
if [ -n "$swift_files" ] && [ -f .swiftformat ] && command -v swiftformat >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  if ! swiftformat --lint $swift_files >/dev/null 2>&1; then
    echo "❌ SwiftFormat: Format passt nicht. Ausführen: swiftformat $swift_files"
    fail=1
  fi
fi

exit $fail
